<!DOCTYPE html>
<html lang="en">
<head>
  <base href="./">
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
  <meta name="description" content="Project Management System - Admin Dashboard">
  <meta name="author" content="Your Name">
  <meta name="keyword" content="Project, Management, System, Admin, Dashboard">
  <title>{{title}}</title>
  <link rel="apple-touch-icon" sizes="57x57" href="assets/favicon/apple-icon-57x57.png">
  <link rel="apple-touch-icon" sizes="60x60" href="assets/favicon/apple-icon-60x60.png">
  <link rel="apple-touch-icon" sizes="72x72" href="assets/favicon/apple-icon-72x72.png">
  <link rel="apple-touch-icon" sizes="76x76" href="assets/favicon/apple-icon-76x76.png">
  <link rel="apple-touch-icon" sizes="114x114" href="assets/favicon/apple-icon-114x114.png">
  <link rel="apple-touch-icon" sizes="120x120" href="assets/favicon/apple-icon-120x120.png">
  <link rel="apple-touch-icon" sizes="144x144" href="assets/favicon/apple-icon-144x144.png">
  <link rel="apple-touch-icon" sizes="152x152" href="assets/favicon/apple-icon-152x152.png">
  <link rel="apple-touch-icon" sizes="180x180" href="assets/favicon/apple-icon-180x180.png">
  <link rel="icon" type="image/png" sizes="192x192" href="assets/favicon/android-icon-192x192.png">
  <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="96x96" href="assets/favicon/favicon-96x96.png">
  <link rel="icon" type="image/png" sizes="16x16" href="assets/favicon/favicon-16x16.png">
  <link rel="manifest" href="assets/favicon/manifest.json">
  <meta name="msapplication-TileColor" content="#ffffff">
  <meta name="msapplication-TileImage" content="assets/favicon/ms-icon-144x144.png">
  <meta name="theme-color" content="#ffffff">
  <!-- Vendors styles-->
  <link rel="stylesheet" href="vendors/simplebar/css/simplebar.css">
  <link rel="stylesheet" href="css/vendors/simplebar.css">
  <!-- Main styles for this application-->
  <link href="css/style.css" rel="stylesheet">
  <!-- We use those styles to show code examples, you should remove them in your application.-->
  <link href="css/examples.css" rel="stylesheet">
  <link href="vendors/@coreui/chartjs/css/coreui-chartjs.css" rel="stylesheet">
  <!-- DataTables CSS -->
  <link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet">
</head>
<body>
  {{> sidebar }} <!-- Include sidebar partial -->
  <div class="wrapper d-flex flex-column min-vh-100 bg-light">
    {{> header }} <!-- Include header partial -->
    <div class="body flex-grow-1 px-3">
      <div class="container-lg">
        <!-- Dashboard Cards -->
        <div class="row">
          <div class="col-sm-6 col-lg-3">
            <div class="card mb-4 text-white bg-primary">
              <div class="card-body pb-0 d-flex justify-content-between align-items-start">
                <div>
                  <div class="fs-4 fw-semibold">{{pendingRequests}} <span class="fs-6 fw-normal">Pending</span></div>
                  <div>Requests</div>
                </div>
                <div class="dropdown">
                  <button class="btn btn-transparent text-white p-0" type="button" data-coreui-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <svg class="icon">
                      <use xlink:href="vendors/@coreui/icons/svg/free.svg#cil-options"></use>
                    </svg>
                  </button>
                  <div class="dropdown-menu dropdown-menu-end">
                    <a class="dropdown-item" href="/admin/requests?status=Pending">View All</a>
                  </div>
                </div>
              </div>
              <div class="c-chart-wrapper mt-3 mx-3" style="height:70px;">
                <canvas class="chart" id="pending-chart" height="70"></canvas>
              </div>
            </div>
          </div>
          
          <div class="col-sm-6 col-lg-3">
            <div class="card mb-4 text-white bg-success">
              <div class="card-body pb-0 d-flex justify-content-between align-items-start">
                <div>
                  <div class="fs-4 fw-semibold">{{completedRequests}} <span class="fs-6 fw-normal">Completed</span></div>
                  <div>Requests</div>
                </div>
                <div class="dropdown">
                  <button class="btn btn-transparent text-white p-0" type="button" data-coreui-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <svg class="icon">
                      <use xlink:href="vendors/@coreui/icons/svg/free.svg#cil-options"></use>
                    </svg>
                  </button>
                  <div class="dropdown-menu dropdown-menu-end">
                    <a class="dropdown-item" href="/admin/requests?status=Completed">View All</a>
                  </div>
                </div>
              </div>
              <div class="c-chart-wrapper mt-3 mx-3" style="height:70px;">
                <canvas class="chart" id="completed-chart" height="70"></canvas>
              </div>
            </div>
          </div>
          
          <div class="col-sm-6 col-lg-3">
            <div class="card mb-4 text-white bg-warning">
              <div class="card-body pb-0 d-flex justify-content-between align-items-start">
                <div>
                  <div class="fs-4 fw-semibold">{{activeUsers}} <span class="fs-6 fw-normal">Active</span></div>
                  <div>Users</div>
                </div>
                <div class="dropdown">
                  <button class="btn btn-transparent text-white p-0" type="button" data-coreui-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <svg class="icon">
                      <use xlink:href="vendors/@coreui/icons/svg/free.svg#cil-options"></use>
                    </svg>
                  </button>
                  <div class="dropdown-menu dropdown-menu-end">
                    <a class="dropdown-item" href="/admin/users">Manage Users</a>
                  </div>
                </div>
              </div>
              <div class="c-chart-wrapper mt-3 mx-3" style="height:70px;">
                <canvas class="chart" id="users-chart" height="70"></canvas>
              </div>
            </div>
          </div>
          
          <div class="col-sm-6 col-lg-3">
            <div class="card mb-4 text-white bg-danger">
              <div class="card-body pb-0 d-flex justify-content-between align-items-start">
                <div>
                  <div class="fs-4 fw-semibold">{{avgResponseTime}} <span class="fs-6 fw-normal">hours</span></div>
                  <div>Avg. Response Time</div>
                </div>
                <div class="dropdown">
                  <button class="btn btn-transparent text-white p-0" type="button" data-coreui-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <svg class="icon">
                      <use xlink:href="vendors/@coreui/icons/svg/free.svg#cil-options"></use>
                    </svg>
                  </button>
                  <div class="dropdown-menu dropdown-menu-end">
                    <a class="dropdown-item" href="/admin/performance">View Performance</a>
                  </div>
                </div>
              </div>
              <div class="c-chart-wrapper mt-3 mx-3" style="height:70px;">
                <canvas class="chart" id="response-chart" height="70"></canvas>
              </div>
            </div>
          </div>
        </div>
        <!-- /.row-->
        
        <!-- Recent Requests Table -->
        <div class="card mb-4">
          <div class="card-header">
            <h4>Recent Requests</h4>
            <div class="btn-group">
              <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-coreui-toggle="dropdown" aria-expanded="false">
                Filter by Status
              </button>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/admin/requests">All Requests</a></li>
                <li><a class="dropdown-item" href="/admin/requests?status=Pending">Pending</a></li>
                <li><a class="dropdown-item" href="/admin/requests?status=In Progress">In Progress</a></li>
                <li><a class="dropdown-item" href="/admin/requests?status=Completed">Completed</a></li>
                <li><a class="dropdown-item" href="/admin/requests?status=Rejected">Rejected</a></li>
              </ul>
            </div>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-striped table-hover" id="requests-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Student</th>
                    <th>Category</th>
                    <th>Semester</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th>Estimated Time</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each recentRequests}}
                  <tr>
                    <td>{{this.id}}</td>
                    <td>{{this.studentName}}<br><small>{{this.studentEmail}}</small></td>
                    <td>{{this.category}}</td>
                    <td>{{this.semester}}</td>
                    <td>
                      <span class="badge bg-{{this.statusBadge}}">{{this.status}}</span>
                    </td>
                    <td>{{this.createdAtFormatted}}</td>
                    <td>{{this.estimatedTime}}</td>
                    <td>
                      <button class="btn btn-sm btn-info view-details" data-id="{{this.id}}">View</button>
                      <button class="btn btn-sm btn-primary update-status" data-id="{{this.id}}">Update</button>
                    </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
        
        <!-- Request Statistics -->
        <div class="row">
          <div class="col-md-6">
            <div class="card mb-4">
              <div class="card-header">
                <h4>Requests by Category</h4>
              </div>
              <div class="card-body">
                <div class="c-chart-wrapper">
                  <canvas id="category-chart" height="300"></canvas>
                </div>
              </div>
            </div>
          </div>
          
          <div class="col-md-6">
            <div class="card mb-4">
              <div class="card-header">
                <h4>Requests by Semester</h4>
              </div>
              <div class="card-body">
                <div class="c-chart-wrapper">
                  <canvas id="semester-chart" height="300"></canvas>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Response Time Trends -->
        <div class="card mb-4">
          <div class="card-header">
            <h4>Response Time Trends</h4>
            <div class="btn-group btn-group-toggle" data-coreui-toggle="buttons">
              <label class="btn btn-outline-secondary active">
                <input type="radio" name="options" id="option1" autocomplete="off" checked> Monthly
              </label>
              <label class="btn btn-outline-secondary">
                <input type="radio" name="options" id="option2" autocomplete="off"> Weekly
              </label>
              <label class="btn btn-outline-secondary">
                <input type="radio" name="options" id="option3" autocomplete="off"> Daily
              </label>
            </div>
          </div>
          <div class="card-body">
            <div class="c-chart-wrapper" style="height:300px;margin-top:40px;">
              <canvas class="chart" id="response-time-chart" height="300"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{> footer }} <!-- Include footer partial -->
  </div>
  
  <!-- Request Details Modal -->
  <div class="modal fade" id="requestDetailsModal" tabindex="-1" aria-labelledby="requestDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="requestDetailsModalLabel">Request Details</h5>
          <button type="button" class="btn-close" data-coreui-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6">
              <h6>Student Information</h6>
              <p><strong>Name:</strong> <span id="detail-student-name"></span></p>
              <p><strong>Email:</strong> <span id="detail-student-email"></span></p>
            </div>
            <div class="col-md-6">
              <h6>Request Information</h6>
              <p><strong>ID:</strong> <span id="detail-request-id"></span></p>
              <p><strong>Status:</strong> <span id="detail-request-status"></span></p>
              <p><strong>Submitted:</strong> <span id="detail-request-date"></span></p>
              <p><strong>Semester:</strong> <span id="detail-request-semester"></span></p>
            </div>
          </div>
          <hr>
          <div class="row">
            <div class="col-md-6">
              <h6>Category</h6>
              <p id="detail-request-category"></p>
            </div>
            <div class="col-md-6">
              <h6>Estimated Completion</h6>
              <p id="detail-request-estimated"></p>
            </div>
          </div>
          <hr>
          <div class="row">
            <div class="col-12">
              <h6>Description</h6>
              <div class="card bg-light p-3">
                <p id="detail-request-description"></p>
              </div>
            </div>
          </div>
          <hr>
          <div class="row" id="admin-notes-section" style="display:none;">
            <div class="col-12">
              <h6>Admin Notes</h6>
              <div class="card bg-light p-3">
                <p id="detail-request-notes"></p>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-coreui-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Update Status Modal -->
  <div class="modal fade" id="updateStatusModal" tabindex="-1" aria-labelledby="updateStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="updateStatusModalLabel">Update Request Status</h5>
          <button type="button" class="btn-close" data-coreui-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="statusUpdateForm">
            <input type="hidden" id="update-request-id">
            <div class="mb-3">
              <label for="status-select" class="form-label">Status</label>
              <select class="form-select" id="status-select" required>
                <option value="Pending">Pending</option>
                <option value="In Progress">In Progress</option>
                <option value="Completed">Completed</option>
                <option value="Rejected">Rejected</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="admin-notes" class="form-label">Admin Notes</label>
              <textarea class="form-control" id="admin-notes" rows="3"></textarea>
            </div>
            <div class="mb-3">
              <label for="estimated-completion" class="form-label">Estimated Completion Time (hours)</label>
              <input type="number" class="form-control" id="estimated-completion" min="1">
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-coreui-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="save-status-btn">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- CoreUI and necessary plugins-->
  <script src="vendors/@coreui/coreui/js/coreui.bundle.min.js"></script>
  <script src="vendors/simplebar/js/simplebar.min.js"></script>
  <!-- Plugins and scripts required by this view-->
  <script src="vendors/chart.js/js/chart.min.js"></script>
  <script src="vendors/@coreui/chartjs/js/coreui-chartjs.js"></script>
  <script src="vendors/@coreui/utils/js/coreui-utils.js"></script>
  <!-- DataTables JS -->
  <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
  
  <script src="js/main.js"></script>
  <script>
    // Initialize DataTable
    $(document).ready(function() {
      $('#requests-table').DataTable({
        order: [[5, 'desc']] // Sort by submission date by default
      });
      
      // Request details modal
      $('.view-details').click(function() {
        const requestId = $(this).data('id');
        // In a real app, you would fetch the details via AJAX
        // For demo, we'll use the data from the table row
        const row = $(this).closest('tr');
        
        $('#detail-student-name').text(row.find('td:eq(1)').text().split('\n')[0]);
        $('#detail-student-email').text(row.find('td:eq(1) small').text());
        $('#detail-request-id').text(row.find('td:eq(0)').text());
        $('#detail-request-status').html(row.find('td:eq(4)').html());
        $('#detail-request-date').text(row.find('td:eq(5)').text());
        $('#detail-request-semester').text(row.find('td:eq(3)').text());
        $('#detail-request-category').text(row.find('td:eq(2)').text());
        $('#detail-request-estimated').text(row.find('td:eq(6)').text());
        // Description would come from AJAX in real app
        $('#detail-request-description').text("This would be the full description from the database.");
        
        const modal = new coreui.Modal(document.getElementById('requestDetailsModal'));
        modal.show();
      });
      
      // Update status modal
      $('.update-status').click(function() {
        const requestId = $(this).data('id');
        $('#update-request-id').val(requestId);
        
        const row = $(this).closest('tr');
        const currentStatus = row.find('td:eq(4) span').text().trim();
        
        $('#status-select').val(currentStatus);
        
        const modal = new coreui.Modal(document.getElementById('updateStatusModal'));
        modal.show();
      });
      
      // Save status changes
      $('#save-status-btn').click(function() {
        const requestId = $('#update-request-id').val();
        const newStatus = $('#status-select').val();
        const notes = $('#admin-notes').val();
        const estimatedTime = $('#estimated-completion').val();
        
        // Here you would make an AJAX call to update the status
        console.log(`Updating request ${requestId} to status ${newStatus} with notes: ${notes}`);
        
        // Simulate success
        alert('Status updated successfully!');
        const modal = coreui.Modal.getInstance(document.getElementById('updateStatusModal'));
        modal.hide();
        
        // In a real app, you would refresh the table or update the row
      });
    });
    
    // Charts initialization
    document.addEventListener('DOMContentLoaded', function() {
      // Card charts
      const cardChart1 = new Chart(document.getElementById('pending-chart'), {
        type: 'line',
        data: {
          labels: ['January', 'February', 'March', 'April', 'May', 'June', 'July'],
          datasets: [{
            label: 'Pending Requests',
            backgroundColor: 'transparent',
            borderColor: 'rgba(255,255,255,.55)',
            pointBackgroundColor: '#321fdb',
            data: [65, 59, 84, 84, 51, 55, 40]
          }]
        },
        options: {
          plugins: {
            legend: {
              display: false
            }
          },
          maintainAspectRatio: false,
          scales: {
            x: {
              grid: {
                display: false,
                drawBorder: false
              },
              ticks: {
                display: false
              }
            },
            y: {
              min: 0,
              max: 100,
              display: false,
              grid: {
                display: false
              },
              ticks: {
                display: false
              }
            }
          },
          elements: {
            line: {
              borderWidth: 1,
              tension: 0.4
            },
            point: {
              radius: 4,
              hitRadius: 10,
              hoverRadius: 4
            }
          }
        }
      });
      
      // Similarly initialize other card charts (completed-chart, users-chart, response-chart)
      
      // Category chart (pie)
      const categoryChart = new Chart(document.getElementById('category-chart'), {
        type: 'pie',
        data: {
          labels: ['Academic', 'Financial', 'Housing', 'Technical', 'Other'],
          datasets: [{
            data: [300, 100, 200, 150, 50],
            backgroundColor: ['#321fdb', '#3399ff', '#f9b115', '#e55353', '#2eb85c']
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'right'
            }
          }
        }
      });
      
      // Semester chart (bar)
      const semesterChart = new Chart(document.getElementById('semester-chart'), {
        type: 'bar',
        data: {
          labels: ['Fall 2023', 'Spring 2024', 'Summer 2024', 'Fall 2024', 'Spring 2025'],
          datasets: [{
            label: 'Requests',
            backgroundColor: '#321fdb',
            data: [120, 150, 80, 200, 180]
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true
            }
          }
        }
      });
      
      // Response time chart (line)
      const responseTimeChart = new Chart(document.getElementById('response-time-chart'), {
        type: 'line',
        data: {
          labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
          datasets: [{
            label: 'Average Response Time (hours)',
            backgroundColor: 'rgba(50, 31, 219, .1)',
            borderColor: '#321fdb',
            pointHoverBackgroundColor: '#fff',
            borderWidth: 2,
            data: [48, 42, 36, 30, 28, 24, 20]
          }]
        },
        options: {
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            }
          },
          scales: {
            x: {
              grid: {
                drawOnChartArea: false
              }
            },
            y: {
              beginAtZero: true,
              ticks: {
                maxTicksLimit: 5
              }
            }
          },
          elements: {
            line: {
              tension: 0.4
            },
            point: {
              radius: 0,
              hitRadius: 10,
              hoverRadius: 4,
              hoverBorderWidth: 3
            }
          }
        }
      });
    });
  </script>
</body>
</html>