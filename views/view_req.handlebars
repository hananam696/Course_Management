<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Requests | Student Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<style>

  .badge-approved {
    background-color: #198754; /* Green for approved */
    color: #fff;
  }
  .badge-cancelled{
    background-color: red;
    color: white;
  }

</style>
<body>
  <!-- Navigation (same as your other pages) -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/">Student Portal</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/request">Dashboard - New Request</a>
        <a class="nav-link active" href="/student/requests">My Requests</a>
        <a class="nav-link" href="/student/cancel">Cancelled Requests</a>
        <a class="nav-link" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="card">
      <div class="card-header">
        <h4>My Requests</h4>
      </div>
      <div class="card-body">
        <div class="col-md-6 mb-4">
          <form action="/student/requests" method="GET">
            <label class="form-label">Select Semester *</label>
            <br>
            <select class="form-control" id="semester" name="semester">
              <option value="all-2025">All Semesters - Year 2025</option>
              <option value="Winter-2025">Winter 2025</option>
              <option value="Spring-2025">Spring 2025</option>
              <option value="Fall-2025">Fall 2025</option>
            </select>
            <button type="submit" style="background-color: #007BFF; color: white; border: none; padding: 6px 12px; border-radius: 4px; display: flex; align-items: center; gap: 5px; cursor: pointer; white-space: nowrap; margin-top: 10px;">
              <span>Filter</span>
              <svg xmlns="http://www.w3.org/2000/svg" height="16" width="16" fill="white" viewBox="0 0 24 24"><path d="M10 18h4v-2h-4v2Zm-7-6h18v-2H3v2Zm3-6v2h12V6H6Z"/></svg>
            </button>
          </form>
        </div>

        {{#if userRequests.length}}
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>S.No.</th>
                <th>Category</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Estimated Process Time</th>
                <th>Cancel Request</th>
                <th>Details</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each userRequests}}
              <tr>
                <td>{{add @index 1}}</td>
                <td>{{this.category}}</td>
                {{!-- <td><span class="badge bg-warning">Pending</span></td> --}}
                <td>
  {{#if (eq this.status 'Approved')}}
    <span class="badge badge-approved">Approved</span>
  {{else if (eq this.status 'Cancelled')}}
    <span class="badge badge-cancelled">Cancelled</span>
  {{else}}
    <span class="badge bg-warning">Pending</span>
  {{/if}}
</td>
                <td>{{formatDate this.createdAt}}</td>
                <td>{{formatDate this.estimatedTime}}</td>
                <td>
                  <form action="/student/requests/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this request?');">
                    <input type="hidden" name="requestId" value="{{this._id}}">
                    <button type="submit" class="btn btn-primary" style="background-color: red;">Cancel Request</button>
                  </form>
                </td>
                <td>
                  <a href="/request/details/{{this._id}}" class="btn btn-primary btn-sm">View Details</a>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="no-requests text-center p-4">
          <p class="fs-5">No requests found
            {{#if selectedSemester}}
              {{#unless (eq selectedSemester 'all-2025')}}
                for {{selectedSemester}}
              {{/unless}}
            {{/if}}
          </p>
          <a href="/request" class="btn btn-primary mt-2">
            Create New Request
          </a>
        </div>
        {{/if}}

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
  // Set the dropdown to the selected value after page loads
  document.addEventListener('DOMContentLoaded', function() {
    var dropdown = document.getElementById('semester');
    var selected = "{{selectedSemester}}";

    if (selected && dropdown) {
      // Set the dropdown to the selected value
      for (var i = 0; i < dropdown.options.length; i++) {
        if (dropdown.options[i].value === selected) {
          dropdown.selectedIndex = i;
          break;
        }
      }
    }
  });
  </script>
</body>
</html>
