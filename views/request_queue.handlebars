<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} | Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .request-card {
      margin-bottom: 1rem;
      border-left: 4px solid #0d6efd;
    }
    .request-card.cancelled {
      border-left-color: #dc3545;
    }
    .request-card.completed {
      border-left-color: #198754;
    }
    .badge-pending {
      background-color: #fd7e14;
    }
    .time-info {
      font-size: 0.85rem;
      color: #6c757d;
    }
    .time-label {
      font-weight: 500;
    }
    .serial-number {
      font-weight: bold;
      color: #495057;
      margin-right: 10px;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/admin">Admin Dashboard</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/admin">Queues</a>
        <a class="nav-link" href="/admin/users">Manage Users</a>
        <a class="nav-link active" href="#">View Requests</a>
        <a class="nav-link" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1>{{category}} Requests</h1>
      <a href="/admin" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    {{#if requests.length}}
    <div class="row">
      <div class="col-12">
        {{#each requests}}
        <div class="card request-card {{#if (eq status 'Cancelled')}}cancelled{{else if (eq status 'Completed')}}completed{{/if}} mb-3">
          <div class="card-body">
            <div class="d-flex align-items-center mb-2">
              <span class="serial-number">{{add @index 1}}.</span>
              <h5 class="card-title mb-0">{{studentName}}</h5>
            </div>
            <h6 class="card-subtitle mb-2 text-muted">{{studentEmail}}</h6>
            <p class="card-text">{{description}}</p>

            <div class="d-flex justify-content-between mb-2">
              <span class="badge bg-warning {{#if (eq status 'Pending')}}badge-pending{{else}}bg-{{statusClass}}{{/if}}">
                {{status}}
              </span>
            </div>

            <!-- 🕓 Estimated Completion for Pending -->
            {{#if (eq status 'Pending')}}
            <div class="time-info">
              <span class="time-label">Estimated Completion:</span>
              <span>{{formatDate estimatedTime}}</span>
            </div>
            {{/if}}

            <div class="mt-3 d-flex gap-2">
              <!-- 🔍 View Details Button -->
              <a href="/admin/request/{{this._id}}" class="btn btn-primary">View Details</a>

              <!-- ✅ CSRF-Protected Approve Form -->
              {{#if (eq status 'Pending')}}
              <form method="POST" action="/admin/approve">
                <input type="hidden" name="requestId" value="{{this._id}}">
                <input type="hidden" name="csrfToken" value="{{../csrfToken}}"> <!-- 🔐 CSRF Token -->
                <button type="submit" class="btn btn-success">Approve</button>
              </form>
              {{/if}}
            </div>

          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{else}}
    <div class="alert alert-info">
      No pending requests found in this queue.
    </div>
    {{/if}}
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
