<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} | Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .request-card {
            margin-bottom: 1rem;
            border-left: 4px solid #0d6efd;
        }
        .request-card.cancelled {
            border-left-color: #dc3545;
        }
        .request-card.completed {
            border-left-color: #198754;
        }
        .badge-pending {
            background-color: #fd7e14;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/admin">Admin Dashboard</a>
            <div class="navbar-nav">
                <a class="nav-link" href="/admin">Queues</a>
                <a class="nav-link" href="/admin/users">Manage Users</a>
                <a class="nav-link active" href="#">View Requests</a>
                <a class="nav-link" href="/logout">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>{{category}} Requests</h1>
            <a href="/admin" class="btn btn-outline-secondary">Back to Dashboard</a>
        </div>

        {{#if requests.length}}
            <div class="row">
                {{#each requests}}
                <div class="col-md-6">
                    <div class="card request-card {{#if (eq status 'Cancelled')}}cancelled{{else if (eq status 'Completed')}}completed{{/if}}">
                        <div class="card-body">
                            <h5 class="card-title">{{studentName}}</h5>
                            <h6 class="card-subtitle mb-2 text-muted">{{studentEmail}}</h6>
                            <p class="card-text">{{description}}</p>
                            <div class="d-flex justify-content-between">
                                <span class="badge rounded-pill {{#if (eq status 'Pending')}}badge-pending{{else}}bg-{{statusClass}}{{/if}}">
                                    {{status}}
                                </span>
                                <small class="text-muted">{{formatDate createdAt}}</small>
                            </div>
                            <div class="mt-3">
                                <a href="/admin/request/{{_id}}" class="btn btn-sm btn-primary">View Details</a>
                                {{#if (eq status 'Pending')}}
                                    <button class="btn btn-sm btn-success">Approve</button>
                                    <button class="btn btn-sm btn-danger">Reject</button>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        {{else}}
            <div class="alert alert-info">
                No pending requests found in this queue.
            </div>
        {{/if}}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>