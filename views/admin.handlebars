<!DOCTYPE html>
<html lang="en">
<head>
  <base href="/">
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
  <title>Admin Dashboard - Request Queues</title>
  <link rel="stylesheet" href="/vendors/simplebar/css/simplebar.css">
  <link rel="stylesheet" href="/css/vendors/simplebar.css">
  <link href="/css/style.css" rel="stylesheet">
  <style>
    /* Sidebar styling */
    .sidebar {
      background-color: #343a40; /* Dark grey */
      color: white;
      width: 250px;
      min-height: 100vh;
      position: fixed;
    }
    .sidebar-brand {
      padding: 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .sidebar-nav {
      padding: 1rem 0;
    }
    .nav-link {
      color: rgba(255,255,255,0.8);
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
    }
    .nav-link:hover {
      color: white;
      background-color: rgba(255,255,255,0.1);
    }
    .nav-link.active {
      color: white;
      background-color: rgba(255,255,255,0.1);
    }
    .nav-icon {
      margin-right: 0.5rem;
    }

    /* Main content area */
    .main-content {
      margin-left: 250px;
      padding: 1.5rem;
      background-color: #f8f9fa;
      min-height: 100vh;
    }

    /* Queue boxes */
    .queue-box {
      background: white;
      border: 1px solid #dee2e6;
      border-radius: 0.5rem;
      padding: 1.5rem;
      height: 100%;
      transition: all 0.2s;
      box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
    }
    .queue-box:hover {
      transform: translateY(-3px);
      box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);
    }
    .queue-title {
      font-size: 1.25rem;
      color: #2c3e50;
      margin-bottom: 0.75rem;
    }
    .queue-count {
      font-size: 2rem;
      font-weight: 600;
      color: #321fdb;
      margin-bottom: 0.5rem;
    }
    .queue-status {
      color: #6c757d;
      margin-bottom: 1.5rem;
    }

    /* Random request section */
    .random-request {
      background: white;
      border-left: 4px solid #e55353;
      padding: 2rem;
      margin-top: 2rem;
      text-align: center;
      border-radius: 0.5rem;
    }

    /* Responsive adjustments */
    @media (max-width: 992px) {
      .sidebar {
        width: 200px;
      }
      .main-content {
        margin-left: 200px;
      }
    }
    @media (max-width: 768px) {
      .sidebar {
        width: 0;
        overflow: hidden;
      }
      .main-content {
        margin-left: 0;
      }
    }
  </style>
</head>
<body>
  <!-- Dark Grey Sidebar -->
  <div class="sidebar">
    <div class="sidebar-brand">
      <h4>Admin Dashboard</h4>
    </div>
    <ul class="sidebar-nav">
      <li class="nav-item">
        <a class="nav-link active" href="/admin">
          <svg class="nav-icon" width="20" height="20">
            <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-speedometer"></use>
          </svg>
          Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/logout">
          <svg class="nav-icon" width="20" height="20">
            <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-account-logout"></use>
          </svg>
          Logout
        </a>
      </li>
    </ul>
  </div>

  <!-- Main Content Area -->
  <div class="main-content">
    <div class="container-fluid">
      <h1 class="mb-4">Request Queues</h1>

    <!-- First Row - 4 Queue Boxes -->
<div class="row">
  {{#each categories}}
    {{#if (lt @index 4)}}
    <div class="col-xl-3 col-lg-6 col-md-6 mb-4">
      <div class="queue-box">
        <h3 class="queue-title">{{this.name}}</h3>
        <div class="queue-count">{{this.count}}</div>
        <p class="queue-status">
          {{#if this.count}}
            {{this.count}} pending {{#if (eq this.count 1)}}request{{else}}requests{{/if}}
          {{else}}
            No pending requests
          {{/if}}
        </p>
        <a href="/admin/queue/{{this.name}}" class="btn btn-primary">
          View Requests
        </a>
      </div>
    </div>
    {{/if}}
  {{/each}}
</div>

<!-- Second Row - 4 Queue Boxes -->
<div class="row">
  {{#each categories}}
    {{#if (gte @index 4)}}
    <div class="col-xl-3 col-lg-6 col-md-6 mb-4">
      <div class="queue-box">
        <h3 class="queue-title">{{this.name}}</h3>
        <div class="queue-count">{{this.count}}</div>
        <p class="queue-status">
          {{#if this.count}}
            {{this.count}} pending {{#if (eq this.count 1)}}request{{else}}requests{{/if}}
          {{else}}
            No pending requests
          {{/if}}
        </p>
        <a href="/admin/queue/{{this.name}}" class="btn btn-primary">
          View Requests
        </a>
      </div>
    </div>
    {{/if}}
  {{/each}}
</div>

      <!-- Random Request Section -->
      <!-- In the random request section of admin.handlebars -->
<!-- Random Request Section -->
<div class="random-request mt-4 p-4 bg-light rounded">
    <h3>Not sure where to start?</h3>
    <p class="mb-4">Process a random pending request from any queue</p>
    <a href="/admin/process-random" class="btn btn-danger">
        <svg class="icon me-2">
            <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-shuffle"></use>
        </svg>
        Process Random Request
    </a>
</div>
    </div>
  </div>

  <!-- JavaScript Libraries -->
  <script src="/vendors/@coreui/coreui/js/coreui.bundle.min.js"></script>
  <script src="/vendors/simplebar/js/simplebar.min.js"></script>

