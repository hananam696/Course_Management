<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Cancelled Requests | Student Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .badge-cancelled {
      background-color: #DC3545;
      color: white;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/">Student Portal</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/request">Dashboard</a>
        <a class="nav-link" href="/student/requests">My Requests</a>
        <a class="nav-link active" href="/student/cancel">Cancelled Requests</a>
        <a class="nav-link" href="/auth/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="card">
      <div class="card-header">
        <h4>Cancelled Requests</h4>
      </div>
      <div class="card-body">
        <div class="col-md-6 mb-4">
          <form action="/student/cancel" method="GET">
            <label class="form-label">Select Semester *</label>
            <select class="form-control" id="semester" name="semester">
              <option value="all-2025">All Semesters - Year 2025</option>
              <option value="Winter-2025">Winter 2025</option>
              <option value="Spring-2025">Spring 2025</option>
              <option value="Fall-2025">Fall 2025</option>
            </select>
            <button type="submit" class="btn btn-primary mt-2">
              <span>Filter</span>
              <svg xmlns="http://www.w3.org/2000/svg" height="16" width="16" fill="white" viewBox="0 0 24 24"><path d="M10 18h4v-2h-4v2Zm-7-6h18v-2H3v2Zm3-6v2h12V6H6Z"/></svg>
            </button>
          </form>
        </div>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>S.No.</th>
                <th>Category</th>
                <th>Status</th>
                <th>Cancelled At</th>
                <th>Created At</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              {{#each cancelledRequests}}
              <tr>
                <td>{{@index}}</td>
                <td>{{this.category}}</td>
                <td><span class="badge badge-cancelled">Cancelled</span></td>
                <td>{{this.cancelledAt}}</td>
                <td>{{this.createdAt}}</td>
                <td>
                  <button type="button" class="btn btn-primary btn-sm view-details"
                          data-requestid="{{this.id}}">View Request</button>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var dropdown = document.getElementById('semester');
      var selected = "{{selectedSemester}}";
      if (selected && dropdown) {
        dropdown.value = selected;
      }
    });
  </script>
</body>
</html>