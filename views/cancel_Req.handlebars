<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Cancelled Requests | Student Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .badge-cancelled {
      background-color: #DC3545;
      color: white;
      padding: 5px 10px;
      border-radius: 4px;
    }
    .no-requests {
      text-align: center;
      padding: 20px;
      color: #6c757d;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/">Student Portal</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/request">Dashboard</a>
        <a class="nav-link" href="/student/requests">My Requests</a>
        <a class="nav-link active" href="/student/cancel">Cancelled Requests</a>
        <a class="nav-link" href="/student/request/new">New Request</a>
        <a class="nav-link" href="/auth/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Cancelled Requests</h4>
        {{#if message}}
          <div class="alert alert-info mb-0 py-2">{{message}}</div>
        {{/if}}
      </div>
      <div class="card-body">
        <div class="col-md-6 mb-4">
          <form action="/student/cancel" method="GET">
            <label class="form-label">Select Semester *</label>
            <select class="form-select" id="semester" name="semester">
              <option value="all-2025">All Semesters - Year 2025</option>
              <option value="Winter-2025">Winter 2025</option>
              <option value="Spring-2025">Spring 2025</option>
              <option value="Fall-2025">Fall 2025</option>
            </select>
            <button type="submit" class="btn btn-primary mt-2">
              <span>Filter</span>
              <svg xmlns="http://www.w3.org/2000/svg" height="16" width="16" fill="white" viewBox="0 0 24 24"><path d="M10 18h4v-2h-4v2Zm-7-6h18v-2H3v2Zm3-6v2h12V6H6Z"/></svg>
            </button>
          </form>
        </div>

        {{#if cancelledRequests.length}}
          <div class="table-responsive">
            <table class="table table-striped">
              <thead>
                <tr>
                  <th>S.No.</th>
                  <th>Category</th>
                  <th>Status</th>
                  <th>Cancelled At</th>
                  <th>Created At</th>
                  <th>Details</th>
                </tr>
              </thead>
              <tbody>
                {{#each cancelledRequests}}
                <tr>
                  <td>{{add @index 1}}</td>
                  <td>{{this.category}}</td>
                  <td><span class="badge badge-cancelled">Cancelled</span></td>
                  <td>{{formatDate this.cancelledAt}}</td>
                  <td>{{formatDate this.createdAt}}</td>
                  <td>
                    <a href="/request/details/{{this._id}}" class="btn btn-primary btn-sm">View Request</a>
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="no-requests">
            <p>No cancelled requests found.</p>
            <a href="/student/request/new" class="btn btn-primary">Create New Request</a>
          </div>
        {{/if}}
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Set the selected semester in dropdown
      const urlParams = new URLSearchParams(window.location.search);
      const selectedSemester = urlParams.get('semester') || 'all-2025';
      document.getElementById('semester').value = selectedSemester;

      // Add confirmation for any actions you might add later
      const actionButtons = document.querySelectorAll('.action-btn');
      actionButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          if (!confirm('Are you sure you want to perform this action?')) {
            e.preventDefault();
          }
        });
      });
    });
  </script>
</body>
</html>