<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Random Request | Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #0d6efd;
            --success-color: #28a745;
            --warning-color: #ffc107;
            --danger-color: #dc3545;
        }
        .container-custom { 
            width: 83%; 
            margin-left: 130px;
            padding: 20px;
        }
        .card-header { 
            background-color: var(--primary-color); 
            color: white; 
            font-weight: 500;
        }
        .list-group-item { 
            padding: 1rem 1.25rem;
            border-left: none;
            border-right: none;
        }
        .card { 
            border: none; 
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15); 
            margin-bottom: 2rem;
        }
        .resolution-form { 
            background-color: #f8f9fa; 
            padding: 1.5rem; 
            border-radius: 0.5rem;
            border: 1px solid #dee2e6;
        }
        .badge-warning { background-color: var(--warning-color); color: #000; }
        .badge-danger { background-color: var(--danger-color); color: #fff; }
        .badge-success { background-color: var(--success-color); color: #fff; }
        .description-card {
            background-color: #f8f9fa;
            border-radius: 0.375rem;
            padding: 1.25rem;
        }
        .timeline-item {
            position: relative;
            padding-left: 2rem;
            margin-bottom: 1.5rem;
        }
        .timeline-item:before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 1rem;
            height: 1rem;
            border-radius: 50%;
            background-color: var(--primary-color);
        }
        .timeline-item:after {
            content: "";
            position: absolute;
            left: 0.45rem;
            top: 1rem;
            width: 2px;
            height: calc(100% - 1rem);
            background-color: #dee2e6;
        }
        .timeline-item:last-child:after {
            display: none;
        }
        @media (max-width: 992px) {
            .container-custom {
                width: 100%;
                margin-left: 0;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/admin">
                <i class="bi bi-speedometer2 me-2"></i>Admin Dashboard
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/admin">
                            <i class="bi bi-grid me-1"></i>Queues
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            <i class="bi bi-list-check me-1"></i>Process Requests
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-custom mt-4">
        <div class="card">
            {{#if request}}
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4><i class="bi bi-shuffle me-2"></i>Random Request Processor</h4>
                <span class="badge bg-warning">Pending</span>
            </div>

            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h5 class="mb-3"><i class="bi bi-person-badge me-2"></i>Student Information</h5>
                        <ul class="list-group">
                            <li class="list-group-item">
                                <strong><i class="bi bi-person me-2"></i>Name:</strong> {{request.studentName}}
                            </li>
                            <li class="list-group-item">
                                <strong><i class="bi bi-envelope me-2"></i>Email:</strong> 
                                <a href="mailto:{{request.studentEmail}}">{{request.studentEmail}}</a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5 class="mb-3"><i class="bi bi-info-circle me-2"></i>Request Details</h5>
                        <ul class="list-group">
                            <li class="list-group-item">
                                <strong><i class="bi bi-tag me-2"></i>Category:</strong> {{request.category}}
                            </li>
                            <li class="list-group-item">
                                <strong><i class="bi bi-clock me-2"></i>Submitted:</strong> {{formatDate request.createdAt}}
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="mb-4">
                    <h5><i class="bi bi-card-text me-2"></i>Description</h5>
                    <div class="description-card">
                        {{request.description}}
                    </div>
                </div>

                <div class="resolution-form mb-4">
                    <h5><i class="bi bi-clipboard-check me-2"></i>Resolution</h5>
                    <form action="/admin/process-random/resolve" method="POST">
                        <input type="hidden" name="requestId" value="{{request._id}}">
                        
                        <div class="mb-3">
                            <label for="resolutionNotes" class="form-label">Notes:</label>
                            <textarea class="form-control" id="resolutionNotes" name="resolutionNotes" rows="3" required></textarea>
                            <div class="form-text">Please provide detailed resolution notes</div>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <button type="submit" name="action" value="approve" class="btn btn-success">
                                <i class="bi bi-check-circle me-1"></i>Approve Request
                            </button>
                            <button type="submit" name="action" value="reject" class="btn btn-danger">
                                <i class="bi bi-x-circle me-1"></i>Reject Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            {{else}}
            <div class="card-body text-center">
                <div class="alert alert-info">
                    <h4><i class="bi bi-check-circle me-2"></i>No pending requests found</h4>
                    <p>All caught up! There are no pending requests to process.</p>
                    <a href="/admin" class="btn btn-primary">
                        <i class="bi bi-grid me-1"></i>Return to Dashboard
                    </a>
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>