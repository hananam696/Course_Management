<div class="container mt-4">
    <div class="card">
        {{#if request}}
        <div class="card-header bg-danger text-white">
            <h4>Random Request Processor</h4>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <h5>Student Information</h5>
                    <ul class="list-group">
                        <li class="list-group-item"><strong>Name:</strong> {{request.studentName}}</li>
                        <li class="list-group-item"><strong>Email:</strong> {{request.studentEmail}}</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h5>Request Details</h5>
                    <ul class="list-group">
                        <li class="list-group-item"><strong>Category:</strong> {{request.category}}</li>
                        <li class="list-group-item"><strong>Submitted:</strong> {{formatDate request.createdAt}}</li>
                    </ul>
                </div>
            </div>

            <div class="mb-3">
                <h5>Description</h5>
                <div class="card bg-light p-3">
                    {{request.description}}
                </div>
            </div>

            <form action="/admin/process-random/resolve" method="POST">
                <input type="hidden" name="requestId" value="{{request._id}}">

                <div class="mb-3">
                    <label class="form-label">Resolution Notes:</label>
                    <textarea name="resolutionNotes" class="form-control" rows="3" required></textarea>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" name="action" value="approve" class="btn btn-success">
                        Approve Request
                    </button>
                    <button type="submit" name="action" value="reject" class="btn btn-danger">
                        Reject Request
                    </button>
                    <a href="/admin/process-random" class="btn btn-secondary">
                        Get Another Request
                    </a>
                </div>
            </form>
        </div>
        {{else}}
        <div class="card-body text-center">
            <div class="alert alert-info">
                <h4>No pending requests found</h4>
                <p>All caught up! There are no pending requests to process.</p>
                <a href="/admin" class="btn btn-primary">Return to Dashboard</a>
            </div>
        </div>
        {{/if}}
    </div>
</div>