<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Request Details | Student Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .badge-warning { background-color: #ffc107; color: #000; }
    .badge-danger { background-color: #dc3545; color: #fff; }
    .badge-success { background-color: #28a745; color: #fff; }
    .container-custom { width: 83%; margin-left: 130px; }
    .card-header { background-color: #0d6efd; color: white; }
    .list-group-item { padding: 1rem 1.25rem; }
    .card { border: none; box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15); }
    .process-section { margin-top: 2rem; border-top: 1px solid #eee; padding-top: 1.5rem; }
  </style>
</head>
<body>
  <!-- Navigation - Same as request.html -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/">Student Portal</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/request">Dashboard</a>
        <a class="nav-link" href="/student/requests">My Requests</a>
        <a class="nav-link active" href="/student/cancel">Cancelled Requests</a>
        <a class="nav-link" href="/student/request/new">New Request</a>
        <a class="nav-link" href="/auth/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container-custom mt-4">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Request Details</h4>
        <a href="{{#if isAdmin}}/admin{{else}}/student/requests{{/if}}" class="btn btn-light">← Back</a>
      </div>
      <div class="card-body">
        <div class="row mb-3">
          <div class="col-md-6">
            <h5 class="mb-3">Basic Information</h5>
            <ul class="list-group">
              <li class="list-group-item">
                <strong>Student Name:</strong> {{request.studentName}}
              </li>
              <li class="list-group-item">
                <strong>Student Email:</strong> {{request.studentEmail}}
              </li>
              <li class="list-group-item">
                <strong>Semester:</strong> {{request.semester}}
              </li>
              <li class="list-group-item">
                <strong>Category:</strong> {{request.category}}
              </li>
              <li class="list-group-item">
                <strong>Status:</strong>
                <span class="badge bg-{{#if (eq request.status 'Pending')}}warning{{else if (eq request.status 'Cancelled')}}danger{{else}}success{{/if}}">
                  {{request.status}}
                </span>
              </li>
              <li class="list-group-item">
                <strong>Created At:</strong> {{formatDate request.createdAt}}
              </li>
            </ul>
          </div>
          <div class="col-md-6">
            <h5 class="mb-3">Timeline</h5>
            <ul class="list-group">
              <li class="list-group-item">
                <strong>Estimated Completion:</strong> {{formatDate request.estimatedTime}}
              </li>
              {{#if request.cancelledAt}}
              <li class="list-group-item">
                <strong>Cancelled At:</strong> {{formatDate request.cancelledAt}}
              </li>
              {{/if}}
              {{#if request.resolvedAt}}
              <li class="list-group-item">
                <strong>Resolved At:</strong> {{formatDate request.resolvedAt}}
              </li>
              {{/if}}
            </ul>
          </div>
        </div>

        <div class="mb-4">
          <h5>Description</h5>
          <div class="card">
            <div class="card-body bg-light">
              {{request.description}}
            </div>
          </div>
        </div>

        {{#if request.resolution}}
        <div class="mb-4">
          <h5>Resolution</h5>
          <div class="card bg-light">
            <div class="card-body">
              {{request.resolution}}
            </div>
          </div>
        </div>
        {{/if}}

        {{#if isAdmin}}
        <div class="process-section">
          <h5>Process Request</h5>
          <form action="/admin/request/{{request._id}}/resolve" method="POST">
            <div class="mb-3">
              <label for="resolutionNotes" class="form-label">Resolution Notes</label>
              <textarea class="form-control" id="resolutionNotes" name="resolutionNotes" rows="3" required></textarea>
            </div>
            <div class="d-flex gap-2">
              <button type="submit" name="action" value="approve" class="btn btn-success">Approve</button>
              <button type="submit" name="action" value="reject" class="btn btn-danger">Reject</button>
              <a href="/admin" class="btn btn-secondary">Back to Dashboard</a>
            </div>
          </form>
        </div>
        {{else}}
        <div class="d-flex justify-content-between mt-4">
          {{#if (eq request.status 'Pending')}}
            <form action="/student/requests/cancel" method="POST" class="d-inline">
              <input type="hidden" name="requestId" value="{{request._id}}">
              <button type="submit" class="btn btn-danger">Cancel Request</button>
            </form>
          {{/if}}

          {{#if (eq request.status 'Cancelled')}}
            <a href="/student/cancel" class="btn btn-secondary">Back to Cancelled Requests</a>
          {{else}}
            <a href="/student/requests" class="btn btn-secondary">Back to My Requests</a>
          {{/if}}
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>