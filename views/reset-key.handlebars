<!DOCTYPE html>
<html lang="en">
<head>
    <title>Enter Reset Key</title>
    <link href="/css/style.css" rel="stylesheet">
    <link rel="stylesheet" href="vendors/simplebar/css/simplebar.css">
</head>
<body>
    <div class="bg-light min-vh-100 d-flex flex-row align-items-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card mb-4 mx-4">
                        <div class="card-body p-4">
                            <h1>Password Reset</h1>
                            {{#if error}}
                            <div class="alert alert-danger">{{error}}</div>
                            {{/if}}
                            
                            <form method="post" action="/activate-password">
                                <div class="input-group mb-3">
                                    <span class="input-group-text">
                                        <svg class="icon"><use xlink:href="vendors/@coreui/icons/svg/free.svg#cil-key"></use></svg>
                                    </span>
                                    <input class="form-control" type="text" name="key" 
                                           placeholder="Paste your reset key here" required>
                                </div>
                                <button class="btn btn-primary w-100">Continue</button>
                            </form>
                            
                            <div class="row mt-3">
                                <div class="col-6 text-start">
                                    <a href="/login" class="btn btn-link">Back to Login</a>
                                </div>
                                <div class="col-6 text-end">
                                    <a href="/forgot-password" class="btn btn-link">Request New Key</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>